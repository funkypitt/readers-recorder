<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Only apps signed with the same key (Reader's Launcher) may read the state and drive the recorder. -->
    <permission
        android:name="com.freedomfighter.readersrecorder.permission.ACCESS"
        android:protectionLevel="signature" />
    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.ReadersRecorder">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:host="com.freedomfighter.readersrecorder" />
            </intent-filter>
        </activity>
        <service
            android:name=".RecordService"
            android:exported="true"
            android:permission="com.freedomfighter.readersrecorder.permission.ACCESS"
            android:foregroundServiceType="microphone" />
        <receiver android:name=".widget.RecordWidget" android:exported="true" android:label="@string/widget_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info" />
        </receiver>
        <provider
            android:name=".provider.StateProvider"
            android:authorities="com.freedomfighter.readersrecorder"
            android:exported="true"
            android:permission="com.freedomfighter.readersrecorder.permission.ACCESS" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.freedomfighter.readersrecorder.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
